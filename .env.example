# JMS environment. Copy to .env for local use.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Required in production (32+ random bytes).
SESSION_SECRET=change-me-to-a-long-random-value

# SQLite database file (created and seeded on first boot).
DATABASE_FILE=jms.db

# Generated PDFs.
PDF_DIR=storage/documents

# Sessions, cookies and display.
SESSION_IDLE_MINUTES=60
COOKIE_SECURE=false
TRUST_PROXY=false
DEFAULT_PASSWORD=JMS123
COMPANY_TIMEZONE=Europe/London
CURRENCY=GBP
VAT_RATE_BP=2000
LOG_LEVEL=info
SEED=20260316

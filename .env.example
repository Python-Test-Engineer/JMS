
# ---- Required ------------------------------------------------------------
# Use a key unique to this project so its spend is tracked separately.
# The running app shows the effective key (masked) in the footer.
OPENROUTER_API_KEY=sk-or-v1-
# OPENROUTER_KEY also works as an alias.

# ---- Model ---------------------------------------------------------------
# Canonical name is OPENROUTER_MODEL; MODEL= is accepted as an alias.
# A bare name (deepseek-v4.1-flash-1017, gpt-5) is normalised to vendor/model.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# JMS environment. Copy to .env for local use.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Required in production (32+ random bytes).
SESSION_SECRET=change-me-to-a-long-random-value

# SQLite database file (created and seeded on first boot).
DATABASE_FILE=jms.db

# Generated PDFs.
PDF_DIR=storage/documents

# Sessions, cookies and display.
SESSION_IDLE_MINUTES=60
COOKIE_SECURE=false
TRUST_PROXY=false
DEFAULT_PASSWORD=JMS123
COMPANY_TIMEZONE=Europe/London
CURRENCY=GBP
VAT_RATE_BP=2000
LOG_LEVEL=info
SEED=20260316

# Google OAuth (optional). Create an OAuth 2.0 Web application in Google Cloud Console.
# Authorised redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Comma-separated Google email addresses that may create an ADMIN account on first sign-in.
GOOGLE_ADMIN_EMAILS=iwswordpress@gmail.com

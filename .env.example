# JMS configuration. Copy to .env and edit. .env is ignored by git.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Required in production: at least 32 random characters.
SESSION_SECRET=change-me-to-a-long-random-value-32-chars

# Storage
DATABASE_FILE=data/jms.sqlite
DOCUMENTS_DIR=storage/documents
BACKUP_DIR=backups
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_WEEKLY=12
BACKUP_KEEP_MONTHLY=12
BACKUP_MAX_AGE_HOURS=36
BACKUP_MIN_FREE_MB=512
BACKUP_LOCK_FILE=data/jms.ops.lock
# Optional: run after a verified backup, e.g. restic or rclone.
# BACKUP_OFFSITE_CMD=restic -r s3:s3.example.com/jms backup

# Sessions and cookies
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false
TRUST_PROXY=false

# Seed and display
AUTO_SEED=false
DEFAULT_PASSWORD=JMS123
SEED=20260316
# Pin the six-week seed horizon (YYYY-MM-DD); defaults to today UTC.
# SEED_DATE=2026-11-18
COMPANY_TIMEZONE=Europe/London
CURRENCY=GBP
VAT_RATE_BP=2000

# SQLite
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_SYNCHRONOUS=NORMAL

# Logging
LOG_LEVEL=info

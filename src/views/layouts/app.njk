<!doctype html>
<html lang="en-GB" data-theme="{{ theme.mode or 'system' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or 'JMS' }} · JMS</title>
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/app.css">
  <style nonce="{{ cspNonce }}">{{ themeCss | safe }}</style>
  <script nonce="{{ cspNonce }}">document.documentElement.classList.add("js");</script>
</head>
<body id="top">
<a class="skip-link" href="#main">Skip to main content</a>
<header class="topbar">
  {% if user %}
  <button class="nav-toggle" type="button" aria-controls="sidebar" aria-expanded="false" aria-label="Open navigation">
    <span class="nav-toggle-icon" aria-hidden="true"></span>
  </button>
  {% endif %}
  <a class="brand" href="/">
    <span class="brand-mark" aria-hidden="true">J</span>
    <span><strong>JMS</strong><small>{{ company.name or 'Acme Windows' }}</small></span>
  </a>
  <form class="global-search" action="/search" method="get" role="search">
    <label class="sr-only" for="global-q">Search jobs, customers and invoices</label>
    <input id="global-q" type="search" name="q" minlength="2" placeholder="Search reference, customer or job…" value="{{ q or '' }}">
    <button class="button button-secondary" type="submit">Search</button>
  </form>
  {% if user %}
  <div class="user-menu">
    <a class="button button-quiet site-settings-link" href="/account/appearance" title="Site settings">
      <span class="site-settings-glyph" aria-hidden="true">Aa</span>
      <span>Site settings</span>
    </a>
    <span class="avatar" aria-hidden="true">{{ user.display_name|initials }}</span>
    <span class="user-meta"><strong>{{ user.display_name }}</strong><small>{{ user.role_key|roleLabel }}</small></span>
    <form method="post" action="/signout">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button class="button button-quiet" type="submit">Sign out</button>
    </form>
  </div>
  {% endif %}
</header>

<div class="shell">
  {% if user %}
  <aside class="sidebar" id="sidebar">
    <nav aria-label="Main navigation">
      {% for group in navGroups %}
      <div class="nav-group">
        <p class="nav-group-label">{{ group.label }}</p>
        <ul>
          {% for entry in group.entries %}
          {% set active = (currentPath == entry.href) or (entry.href != '/' and currentPath.startsWith(entry.href)) %}
          <li><a class="nav-pill{% if active %} is-active{% endif %}" href="{{ entry.href }}" {% if active %}aria-current="page"{% endif %}>{{ entry.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </nav>
  </aside>
  {% endif %}

  <main id="main" class="content" tabindex="-1">
    {% if flash %}
    <div class="alert alert-{{ flash.type }}" role="status">{{ flash.message }}</div>
    {% endif %}
    <div class="page-head">
      <div>
        <p class="eyebrow">{{ company.name or 'Acme Windows' }} · {{ user.role_key|roleLabel if user else 'JMS' }}</p>
        <h1>{{ title }}</h1>
      </div>
      {% block pageActions %}{% endblock %}
    </div>
    {% block content %}{% endblock %}
  </main>
</div>

<footer class="footer">
  <span>JMS v1 · SQLite database · display timezone {{ company.timezone or 'Europe/London' }}</span>
  <span class="mono" title="OpenRouter API key in use">OpenRouter key {{ openRouterKeyMasked }}</span>
  {% if requestId %}<span class="mono">Request {{ requestId }}</span>{% endif %}
</footer>
<a class="back-to-top" href="#top" aria-label="Back to top">
  <span aria-hidden="true">&uarr;</span>
  <span class="sr-only">Back to top</span>
</a>
<script src="/assets/js/app.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>

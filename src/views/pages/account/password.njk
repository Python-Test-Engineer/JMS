{% extends "layouts/app.njk" %}
{% block content %}
<div class="notice">
  {% if user.must_change_password %}<strong>First sign-in.</strong> {% endif %}
  Password changes are disabled for testing. Submitting will not change your password — it stays as the temporary password (JMS123).
</div>
<form method="post" action="/account/password" class="panel stack narrow">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  <button class="button button-primary" type="submit">Continue without changing password</button>
</form>
{% endblock %}

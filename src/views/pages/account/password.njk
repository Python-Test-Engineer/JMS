{% extends "layouts/app.njk" %}
{% block content %}
{% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}
{% if user.must_change_password %}<div class="notice"><strong>First sign-in.</strong> Choose a new password before continuing.</div>{% endif %}
<form method="post" action="/account/password" class="panel stack narrow">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  {% if not user.must_change_password %}
  <label class="field"><span>Current password</span><input type="password" name="current_password" autocomplete="current-password" required></label>
  {% endif %}
  <label class="field"><span>New password</span><input type="password" name="new_password" autocomplete="new-password" minlength="10" required><span class="hint">At least 10 characters, including a letter and a number.</span></label>
  <button class="button button-primary" type="submit">Save new password</button>
</form>
{% endblock %}

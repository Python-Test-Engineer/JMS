{% extends "layouts/app.njk" %}
{% block content %}
{% if user.must_change_password %}
<div class="notice">
  <strong>First sign-in.</strong> Choose a new password before continuing. The temporary password you used is no longer enough.
</div>
{% endif %}
<form method="post" action="/account/password" class="panel stack narrow">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  {% if not user.must_change_password %}
  <label class="field">
    <span>Current password</span>
    <input type="password" name="current_password" autocomplete="current-password" required>
    {% if errors.current_password %}<span class="field-error">{{ errors.current_password }}</span>{% endif %}
  </label>
  {% endif %}
  <label class="field">
    <span>New password</span>
    <input type="password" name="new_password" autocomplete="new-password" minlength="10" required>
    <span class="hint">At least 10 characters, with a letter and a number.</span>
    {% if errors.new_password %}<span class="field-error">{{ errors.new_password }}</span>{% endif %}
  </label>
  <label class="field">
    <span>Confirm new password</span>
    <input type="password" name="confirm_password" autocomplete="new-password" minlength="10" required>
    {% if errors.confirm_password %}<span class="field-error">{{ errors.confirm_password }}</span>{% endif %}
  </label>
  <button class="button button-primary" type="submit">Save password</button>
</form>
{% endblock %}

{% extends "layouts/app.njk" %}
{% import "partials/theme-fields.njk" as themeFields %}
{% block content %}
{% set userColors = [
  ['paper', 'Page background'],
  ['ink', 'Body text'],
  ['terra', 'Accent'],
  ['terra_dark', 'Links and accent text']
] %}
<form method="post" action="/account/appearance" class="stack narrow" data-theme-form>
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">

  <div class="panel stack">
    <h2>Colour scheme</h2>
    <fieldset class="fieldset">
      <legend class="sr-only">Colour scheme</legend>
      <div class="choice-row">
        {% for option in ['system','light','dark'] %}
        <label class="choice"><input type="radio" name="mode" value="{{ option }}" {% if theme.mode == option %}checked{% endif %}> {{ option|capitalize }}</label>
        {% endfor %}
      </div>
    </fieldset>
  </div>

  <div class="panel stack">
    <h2>Type</h2>
    {{ themeFields.numberGrid(typeFields, theme.type, 'type_') }}
  </div>

  <div class="panel stack">
    <h2>Fonts</h2>
    {{ themeFields.fontGrid(fontFields, theme.fonts) }}
  </div>

  <div class="panel stack">
    <h2>Colours</h2>
    <p class="hint">Light</p>
    {{ themeFields.colorGrid(userColors, theme.colors, 'colors_', 'light') }}
    <p class="hint">Dark</p>
    {{ themeFields.colorGrid(userColors, theme.dark, 'dark_', 'dark') }}
  </div>

  <div class="button-row">
    <button class="button button-primary" type="submit">Save appearance</button>
    <button class="button button-secondary" type="submit" name="reset" value="1">Use company defaults</button>
  </div>
</form>
<p class="muted">Appearance preferences belong to your account, like the Aa panel in the JMS guide pages. The company default still applies to anyone who has not chosen.{% if personalised %} This account has its own saved theme.{% endif %}</p>
{% endblock %}
{% block scripts %}<script src="/assets/js/theme-preview.js" defer></script>{% endblock %}

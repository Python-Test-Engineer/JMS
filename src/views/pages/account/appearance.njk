{% extends "layouts/app.njk" %}
{% block content %}
<form method="post" action="/account/appearance" class="stack narrow">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  <div class="panel stack">
    <h2>Colour scheme</h2>
    <div class="choice-row">
      {% for option in ['system','light','dark'] %}
      <label class="choice"><input type="radio" name="mode" value="{{ option }}" {% if theme.mode == option %}checked{% endif %}> {{ option|capitalize }}</label>
      {% endfor %}
    </div>
  </div>
  <div class="panel stack">
    <h2>Text size</h2>
    <div class="choice-row">
      {% for option in ['small','normal','large'] %}
      <label class="choice"><input type="radio" name="text" value="{{ option }}" {% if theme.text == option %}checked{% endif %}> {{ option|capitalize }}</label>
      {% endfor %}
    </div>
  </div>
  <div class="panel stack">
    <h2>Line spacing</h2>
    <div class="choice-row">
      {% for option in ['tight','normal','airy'] %}
      <label class="choice"><input type="radio" name="leading" value="{{ option }}" {% if theme.leading == option %}checked{% endif %}> {{ option|capitalize }}</label>
 

{% extends "layouts/app.njk" %}
{% block content %}
<form method="post" action="/account/appearance" class="panel stack narrow">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  <fieldset class="field">
    <legend>Theme</legend>
    <div class="choice-row">
      {% for option in ['system','light','dark'] %}
      <label class="choice"><input type="radio" name="mode" value="{{ option }}" {% if prefs.mode == option %}checked{% endif %}> {{ option|capitalize }}</label>
      {% endfor %}
    </div>
  </fieldset>
  <label class="field">
    <span>Text size</span>
    <input type="range" name="text_scale" min="0.9" max="1.35" step="0.05" value="{{ prefs.text_scale }}">
    <span class="hint">0.90 is compact, 1.00 is the default, 1.35 is largest.</span>
  </label>
  <label class="field">
    <span>Line height</span>
    <input type="range" name="line_height" min="1.3" max="1.9" step="0.05" value="{{ prefs.line_height }}">
  </label>
  <button class="button button-primary" type="submit">Save appearance</button>
</form>
<p class="muted">Appearance preferences belong to your account. The company default still applies to anyone who has not chosen.</p>
{% endblock %}

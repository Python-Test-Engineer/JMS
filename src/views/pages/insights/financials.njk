{% extends "layouts/app.njk" %}
{% import "macros/ui.njk" as ui %}
{% block content %}
<div class="stat-grid">
  <div class="stat"><strong>{{ quoted.net|money }}</strong><span>Open quoted work ({{ quoted.n }} jobs)</span></div>
  <div class="stat"><strong>{{ totals.issued_net|money }}</strong><span>Invoiced, unpaid (net)</span></div>
  <div class="stat"><strong>{{ totals.paid_net|money }}</strong><span>Paid (net)</span></div>
  <div class="stat"><strong>{{ totals.draft_net|money }}</strong><span>Draft invoices</span></div>
  <div class="stat"><strong>{{ totals.void_net|money }}</strong><span>Voided</span></div>
</div>
<section class="panel">
  <h2>By invoice status</h2>
  <table class="data-table">
    <thead><tr><th>Status</th><th class="num">Count</th><th class="num">Gross</th></tr></thead>
    <tbody>
      {% for row in byStatus %}<tr><td>{{ row.status|capitalize }}</td><td class="num">{{ row.n }}</td><td class="num">{{ row.gross|money }}</td></tr>{% endfor %}
    </tbody>
  </table>
</section>
<section class="panel">
  <h2>Recent invoices</h2>
  {% if recent.length %}
  <table class="data-table">
    <thead><tr><th>Number</th><th>Customer</th><th>Issued</th><th>Status</th><th class="num">Gross</th></tr></thead>
    <tbody>
      {% for invoice in recent %}
      <tr><td><a class="mono" href="/invoices/{{ invoice.id }}">{{ invoice.number or 'Draft' }}</a></td><td>{{ invoice.customer_name }}</td><td>{{ invoice.issued_at|date if invoice.issued_at else '—' }}</td><td><span class="pill pill-{{ invoice.status|lower }}">{{ invoice.status|capitalize }}</span></td><td class="num">{{ invoice.gross|money }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}<p class="muted">No invoices yet.</p>{% endif %}
</section>
{% endblock %}

{% extends "layouts/app.njk" %}
{% block content %}
<section class="panel stack">
  <h2>Latest verified snapshot</h2>
  {% if status.file %}
  <dl class="facts">
    <dt>File</dt><dd class="mono">{{ status.file }}</dd>
    <dt>Created</dt><dd>{{ status.createdAt|datetime }}</dd>
    <dt>Age</dt><dd>{{ status.ageHours }} hours</dd>
    <dt>Verified</dt><dd>{{ 'Yes' if status.verified else 'No — investigate' }}</dd>
    <dt>Size</dt><dd>{{ (status.sizeBytes / 1024)|round(1) }} KB</dd>
    {% if status.counts %}<dt>Rows</dt><dd>{% for key, value in status.counts %}{{ key }}: {{ value }}{% if not loop.last %} · {% endif %}{% endfor %}</dd>{% endif %}
  </dl>
  {% else %}
  <p>No verified backup exists yet. Run <code>npm run backup</code> or install the cron job in the README.</p>
  {% endif %}
</section>
<section class="panel stack">
  <h2>Backup policy</h2>
  <p>Nightly cron snapshots are integrity-checked, checksummed and retained as 30 daily, 12 weekly and 12 monthly copies. Offsite copying is configured with <code>BACKUP_OFFSITE_CMD</code>.</p>
</section>
{% endblock %}

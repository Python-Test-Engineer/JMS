{
  "name": "jms",
  "version": "2.0.0",
  "private": true,
  "description": "Acme Windows Job Management System â€” TypeScript, Express 5, Nunjucks and SQLite",
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:watch": "tsx --test --watch tests/**/*.test.ts",
    "check": "npm run typecheck && npm test",
    "db:migrate": "node dist/cli/jms.js migrate",
    "db:check": "node dist/cli/jms.js check",
    "seed": "node dist/cli/jms.js seed",
    "seed:force": "node dist/cli/jms.js seed --force",
    "reset": "node dist/cli/jms.js reset --force",
    "backup": "node dist/cli/jms.js backup --tag manual",
    "backup:verify": "node dist/cli/jms.js verify --latest",
    "backup:prune": "node dist/cli/jms.js prune --apply",
    "restore": "node dist/cli/jms.js restore"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^13.2.0",
    "commander": "^14.0.0",
    "compression": "^1.8.0",
    "cookie": "^1.0.2",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "htmx.org": "^2.0.6",
    "luxon": "^3.6.1",
    "nunjucks": "^3.2.4",
    "pdfkit": "^0.17.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.15.0",
    "@types/nunjucks": "^3.2.6",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}

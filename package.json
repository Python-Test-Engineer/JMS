{
  "name": "jms",
  "version": "1.0.0",
  "private": true,
  "description": "Acme Windows Job Management System — Node, Express, Nunjucks and SQLite",
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
